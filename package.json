{
  "name": "ptransfer",
  "private": true,
  "version": "0.0.3",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cli": "bun cli/main.ts",
    "lint": "biome check --reporter=rdjson",
    "preview": "vite preview",
    "test": "bun run test:unit",
    "test:all": "bun run test:unit && bun run test:integration:nostr-file",
    "test:unit": "vitest run --project unit",
    "test:tui": "bun test tui.test",
    "test:integration:nostr-file": "vitest run --project integration",
    "test:live": "bun run test:live:nostr-file && bun run test:live:web",
    "test:live:code:cli": "bun tests/live_code_cli_e2e.ts",
    "test:live:code:cli-web": "bun tests/live_code_cli_web_e2e.ts",
    "test:live:tor:cli": "bun tests/live_tor_cli_e2e.ts",
    "test:live:tor:web": "bun tests/live_tor_web_e2e.ts",
    "webtor:status": "bun scripts/webtor-source.ts status",
    "webtor:local": "bun scripts/webtor-source.ts local",
    "webtor:released": "bun scripts/webtor-source.ts released",
    "test:live:nostr-file": "bun tests/live_nostr_file_e2e.ts",
    "test:live:web": "bun tests/live_web_to_web_e2e.ts"
  },
  "dependencies": {
    "@andrewtheguy/fast-qr-wasm": "https://github.com/andrewtheguy/fast_qr/releases/download/v0.0.5/andrewtheguy-fast-qr-wasm-0.0.5.tgz",
    "@andrewtheguy/rxing-wasm": "https://github.com/andrewtheguy/rxing-reader/releases/download/v0.0.12/andrewtheguy-rxing-wasm-0.0.12.tgz",
    "@andrewtheguy/webtor-wasm": "https://github.com/andrewtheguy/webtor-rs/releases/download/v0.0.1-alpha.25/andrewtheguy-webtor-wasm-0.0.1-alpha.25.tgz",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.561.0",
    "node-datachannel": "^0.33.3",
    "nostr-tools": "^2.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11"
  }
}
